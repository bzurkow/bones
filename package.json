{
  "name": "bones",
  "version": "1.0.0",
  "description": "",
  "private": true,
  "workspaces": [
    "backend",
    "web-app",
    "shared-ui",
    "web-static"
  ],
  "scripts": {
    "test": "yarn workspace backend test",
    "install:all": "yarn --cwd backend install && yarn --cwd web-app install && yarn --cwd shared-ui install && yarn --cwd web-static install",
    "initialize-backend": "sh scripts/initialize-backend.sh",
    "backend:dev": "NODE_VERSION=$(cat .node-version) docker compose up",
    "web-app:dev": "yarn workspace web-app dev",
    "web-static:dev": "yarn workspace web-static dev",
    "lint": "oxlint && syncpack lint",
    "lint:fix": "oxlint --fix && syncpack fix",
    "deps:check": "syncpack lint",
    "deps:fix": "syncpack fix"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.4.0",
    "oxlint": "^1.81.0",
    "syncpack": "^15.3.3",
    "typescript": "~7.0.2"
  }
}
